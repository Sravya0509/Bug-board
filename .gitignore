# Environment files and credentials
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
backend/.env.*

# Allow committing environment templates
!.env.example
!backend/.env.example
!*/.env.example

# Local database backups (contain private local data)
database/backup_before_reset.sql
database/*backup*.sql
database/*.dump
*.sql.bak
!database/schema.sql

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/

# Production build artifacts
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/

# Logs and runtime files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor directories and OS files
.vscode/
.idea/
.DS_Store
Thumbs.db
